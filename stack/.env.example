# Copier en .env et adapter, ou exporter ces variables avant d'appeler les scripts.

# Série Odoo cible. Laisser vide : odoo-stack.sh la déduit du module trouvé dans
# ODOO_ADDONS_DIR (préfixe de `version` du manifest, ou .odoo-agents/config).
# ODOO_SERIES=18.0

# Répertoire contenant le(s) module(s) custom à tester (monté sur /mnt/extra-addons).
ODOO_ADDONS_DIR=/chemin/vers/le/projet_odoo

# Ports exposés sur l'hôte (choisis pour ne pas entrer en conflit avec les
# autres stacks du poste : neca-local occupe 8070/8073).
ODOO_HTTP_PORT=8079
ODOO_GEVENT_PORT=8082
ODOO_DB_PORT=5439
